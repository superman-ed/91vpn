APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
# [!!] APP_URL 要填【用户面】的地址 —— 订阅链接与节点的 webapi_url 都由它派生。
#   填成后台那个主机名的话,每个用户和节点都会撞上 Access 登录页。
#   本地先跑通时用 http://localhost:8088 即可。
APP_URL=http://localhost:8088

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- 数据库 ----
# [!] 这几项对应 docker-compose.yml 里的 db 服务，照抄即可跑起来。
#     换成外部数据库时再改。
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=vpn
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 后台隧道(ADR-008/P0)。CF 面板建 named tunnel 拿到的 token 填这里,再起 cloudflared 服务。
# 域名/路由(→ http://web:8080)/Access 身份门都在 CF 面板配,不在代码里。留空=cloudflared 不启动。
# ---- 后台专用主机名 ----
# [!!] 配了之后 /admin/* 只能从这个主机名进,其余一律 404。
#   它是"两个主机名共用一个应用"这套做法的补挡:用户面那个主机名【没有
#   Cloudflare Access】,不挡的话后台等于从侧门敞着。
#   本地开发/还没上隧道时【留空】,否则你自己也进不去后台。
ADMIN_HOST=

CLOUDFLARE_TUNNEL_TOKEN=
